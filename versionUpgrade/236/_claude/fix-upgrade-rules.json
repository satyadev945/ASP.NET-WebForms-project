          "steps": [
            "Install Microsoft.EntityFrameworkCore packages",
            "Migrate DbContext to EF Core",
            "Update entity configurations",
            "Migrate database initializers to migrations",
            "Update LINQ queries for EF Core compatibility",
            "Test all data access operations thoroughly"
          ]
        },
        {
          "category": "Logging",
          "migration": "Legacy logging to Microsoft.Extensions.Logging",
          "criticality": "HIGH",
          "steps": [
            "Install Microsoft.Extensions.Logging or Serilog.AspNetCore",
            "Configure logging in Program.cs",
            "Replace all ILog references with ILogger<T>",
            "Update logging statements to use structured logging",
            "Remove legacy logging configuration files",
            "Test logging at all levels (Debug, Info, Warning, Error)"
