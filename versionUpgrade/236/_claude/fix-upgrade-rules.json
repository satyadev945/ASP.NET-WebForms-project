    "compatibilityChecks": {
      "description": "Pre-migration checks to identify compatibility issues",
      "checks": [
        {
          "name": "NuGet Package Compatibility",
          "description": "Verify all NuGet packages support .NET 8",
          "action": "Check each package on nuget.org for .NET 8 / .NET Standard 2.0+ support",
          "severity": "CRITICAL"
        },
        {
          "name": "API Compatibility",
          "description": "Identify usage of .NET Framework-only APIs",
          "action": "Use .NET Upgrade Assistant or compatibility analyzer to scan code",
          "severity": "CRITICAL"
        },
        {
          "name": "Custom MSBuild Tasks",
          "description": "Verify custom MSBuild tasks are .NET 8 compatible",
          "action": "Update MSBuild tasks to target .NET 8 SDK",
          "severity": "MEDIUM"
        },
        {
          "name": "Third-Party Library Support",
          "description": "Ensure third-party libraries have .NET 8 versions",
          "action": "Contact vendors or find alternatives for unsupported libraries",
          "severity": "HIGH"
        },
        {
          "name": "System.Web Dependencies",
          "description": "Identify and eliminate System.Web dependencies",
          "action": "Replace all System.Web usages with ASP.NET Core equivalents",
          "severity": "CRITICAL"
        }
      ]
    },

    "preventionRules": {
      "description": "Rules to prevent compatibility issues in generated code",
      "rules": [
        {
          "rule": "COMPAT-001",
          "name": "No Entity Framework 6",
          "description": "Never generate code that uses EntityFramework (EF6)",
          "enforcement": "Always use Microsoft.EntityFrameworkCore 8.0.0+"
        },
        {
          "rule": "COMPAT-002",
          "name": "No Legacy Logging",
          "description": "Never use log4net or old NLog versions",
          "enforcement": "Always use Microsoft.Extensions.Logging or Serilog.AspNetCore 8.0.0"
        },
        {
          "rule": "COMPAT-003",
          "name": "No System.Web References",
          "description": "Never reference System.Web assemblies",
          "enforcement": "Use ASP.NET Core equivalents (IHttpContextAccessor, IWebHostEnvironment, etc.)"
        },
        {
          "rule": "COMPAT-004",
          "name": "No Web.config",
          "description": "Never generate Web.config files",
          "enforcement": "Always use appsettings.json for configuration"
        },
        {
          "rule": "COMPAT-005",
          "name": "Verified Package Versions",
          "description": "Only use packages verified to work with .NET 8",
          "enforcement": "All package references must specify .NET 8 compatible versions"
        },
        {
          "rule": "COMPAT-006",
          "name": "No Global.asax Logic",
          "description": "Never migrate Global.asax patterns directly",
          "enforcement": "Move application startup logic to Program.cs and use middleware"
        },
        {
          "rule": "COMPAT-007",
          "name": "No HttpContext.Current",
          "description": "Never use HttpContext.Current pattern",
          "enforcement": "Always inject IHttpContextAccessor and use HttpContext property"
        },
        {
          "rule": "COMPAT-008",
          "name": "SDK-Style Projects Only",
          "description": "Always generate SDK-style project files",
          "enforcement": "Use <Project Sdk=\"Microsoft.NET.Sdk.Web\"> format"
        }
      ]
    },

    "verificationSteps": {
      "description": "Steps to verify .NET 8 compatibility after migration",
      "steps": [
        {
          "step": 1,
          "name": "Package Analysis",
          "description": "Verify no forbidden packages are referenced",
          "command": "dotnet list package --vulnerable --include-transitive",
          "expectedResult": "No EF6, log4net, or System.Web packages"
        },
        {
          "step": 2,
          "name": "Build Verification",
          "description": "Ensure solution builds successfully on .NET 8",
          "command": "dotnet build --configuration Release",
          "expectedResult": "Build succeeds with no errors"
        },
        {
          "step": 3,
          "name": "Target Framework Check",
          "description": "Verify all projects target net8.0",
          "command": "grep -r 'TargetFramework' **/*.csproj",
          "expectedResult": "All projects show <TargetFramework>net8.0</TargetFramework>"
        },
        {
          "step": 4,
          "name": "Compatibility Analyzer",
          "description": "Run .NET API compatibility analyzer",
          "command": "dotnet tool install -g Microsoft.DotNet.UpgradeAssistant.Cli && upgrade-assistant analyze",
          "expectedResult": "No critical compatibility issues"
        },
        {
          "step": 5,
          "name": "Runtime Verification",
          "description": "Test application runs successfully",
          "command": "dotnet run --project src/[ProjectName].Web",
          "expectedResult": "Application starts without runtime errors"
        }
      ]
    },

    "migrationWarnings": {
      "description": "Common issues to watch for during migration",
      "warnings": [
        {
          "warning": "EF6 Lazy Loading",
          "description": "EF6 lazy loading behavior differs from EF Core",
          "solution": "Use explicit .Include() or enable lazy loading proxies in EF Core"
        },
        {
          "warning": "DateTime Handling",
          "description": "EF Core handles DateTime differently than EF6",
          "solution": "Explicitly specify DateTime.Kind and use DateTimeOffset where appropriate"
        },
        {
          "warning": "Connection Resiliency",
          "description": "EF Core requires explicit configuration for retry logic",
          "solution": "Configure EnableRetryOnFailure in DbContext options"
        },
        {
          "warning": "Session State",
          "description": "Session state works differently in ASP.NET Core",
          "solution": "Configure distributed cache or use TempData for temporary storage"
        },
        {
          "warning": "Output Caching",
          "description": "ASP.NET Core has different caching mechanisms",
          "solution": "Use response caching or output caching middleware"
        },
        {
          "warning": "Custom HTTP Modules",
          "description": "HTTP modules don't exist in ASP.NET Core",
          "solution": "Implement as middleware in the pipeline"
        },
        {
          "warning": "Custom HTTP Handlers",
          "description": "HTTP handlers are replaced by middleware",
          "solution": "Implement as middleware or minimal API endpoints"
        }
      ]
    }
  }
