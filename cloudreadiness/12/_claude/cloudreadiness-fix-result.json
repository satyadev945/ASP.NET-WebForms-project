server.host=${SERVER_HOST:0.0.0.0}
database.username=${DATABASE_USERNAME:root}
database.password=${DATABASE_PASSWORD:changeme}
cache.redis.password=${REDIS_PASSWORD:}
external.api.key=${EXTERNAL_API_KEY:}
app.log.directory=${APP_LOG_DIR:/tmp/logs}
```

