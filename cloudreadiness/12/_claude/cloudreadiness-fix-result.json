}
```

## Environment Variables Configuration

### Required Environment Variables for Production

```bash
# Server Configuration
export SERVER_PORT=8080
export SERVER_HOST=0.0.0.0
export SERVER_CONTEXT_PATH=/mini-app

# Database Configuration (use AWS Secrets Manager in production)
export DATABASE_URL=jdbc:mysql://your-rds-endpoint:3306/mini_app_db
export DATABASE_USERNAME=app_user
export DATABASE_PASSWORD=<from-aws-secrets-manager>
export DB_MAX_POOL_SIZE=20
export DB_CONNECTION_TIMEOUT=30000
export DB_QUERY_TIMEOUT=30

# Redis Configuration (AWS ElastiCache)
export REDIS_HOST=your-elasticache-endpoint
export REDIS_PORT=6379
export REDIS_PASSWORD=<from-aws-secrets-manager>

# External Services
export EXTERNAL_API_URL=https://api.example.com/v1
export EXTERNAL_API_KEY=<from-aws-secrets-manager>
export EXTERNAL_API_TIMEOUT=30000

# Payment Service
export PAYMENT_SERVICE_URL=https://payment.service.com/process
export PAYMENT_SERVICE_USERNAME=<from-aws-secrets-manager>
export PAYMENT_SERVICE_PASSWORD=<from-aws-secrets-manager>

# Security (use AWS Secrets Manager)
export JWT_SECRET=<from-aws-secrets-manager>
export ADMIN_USERNAME=<from-aws-secrets-manager>
export ADMIN_PASSWORD=<from-aws-secrets-manager>
export ENCRYPTION_KEY=<from-aws-secrets-manager>

# Monitoring
export MONITORING_ENDPOINT=https://monitoring.service.com/metrics
export MONITORING_USERNAME=<from-aws-secrets-manager>
export MONITORING_PASSWORD=<from-aws-secrets-manager>

# Messaging (or use AWS SQS/SNS)
export RABBITMQ_HOST=your-rabbitmq-endpoint
export RABBITMQ_PORT=5672
export RABBITMQ_USERNAME=<from-aws-secrets-manager>
export RABBITMQ_PASSWORD=<from-aws-secrets-manager>

# Application Settings
export ENVIRONMENT=production
export DEBUG_ENABLED=false
export LOGGING_LEVEL=INFO
```

