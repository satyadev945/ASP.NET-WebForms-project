### Infrastructure as Code (IaC)

**Recommendation: Use AWS CDK (Cloud Development Kit)**

```java
// Example CDK code for Mini App infrastructure
public class MiniAppStack extends Stack {
    public MiniAppStack(Construct scope, String id) {
        super(scope, id);
        
        // VPC
        Vpc vpc = Vpc.Builder.create(this, "MiniAppVpc")
            .maxAzs(2)
            .build();
        
        // RDS MySQL
        DatabaseInstance database = DatabaseInstance.Builder.create(this, "Database")
            .engine(DatabaseInstanceEngine.mysql(MySqlInstanceEngineProps.builder()
                .version(MysqlEngineVersion.VER_8_0_33)
                .build()))
            .vpc(vpc)
            .credentials(Credentials.fromSecret(
                Secret.fromSecretNameV2(this, "DBSecret", "mini-app/db-credentials")
            ))
            .build();
        
        // ElastiCache Redis
        CfnReplicationGroup redis = CfnReplicationGroup.Builder.create(this, "Redis")
            .replicationGroupDescription("Mini App Cache")
            .engine("redis")
            .cacheNodeType("cache.t3.micro")
            .numCacheClusters(2)
            .automaticFailoverEnabled(true)
            .build();
        
        // ECS Cluster
        Cluster cluster = Cluster.Builder.create(this, "MiniAppCluster")
            .vpc(vpc)
            .build();
        
        // Fargate Service
        ApplicationLoadBalancedFargateService service = 
            ApplicationLoadBalancedFargateService.Builder.create(this, "MiniAppService")
                .cluster(cluster)
                .taskImageOptions(ApplicationLoadBalancedTaskImageOptions.builder()
                    .image(ContainerImage.fromRegistry("mini-app:latest"))
                    .environment(Map.of(
                        "DB_HOST", database.getDbInstanceEndpointAddress(),
                        "REDIS_HOST", redis.getAttrPrimaryEndPoint().getAddress()
                    ))
                    .secrets(Map.of(
                        "DB_PASSWORD", Secret.fromSecretsManager(dbSecret)
                    ))
                    .build())
                .desiredCount(2)
                .build();
    }
}
```

