      "content": "=== ecs/task-definition.json ===\n{\n  \"family\": \"mini-java-app-task\",\n  \"networkMode\": \"awsvpc\",\n  \"requiresCompatibilities\": [\"FARGATE\"],\n  \"cpu\": \"512\",\n  \"memory\": \"1024\",\n  \"executionRoleArn\": \"arn:aws:iam::{{ACCOUNT_ID}}:role/ecsTaskExecutionRole\",\n  \"taskRoleArn\": \"arn:aws:iam::{{ACCOUNT_ID}}:role/ecsTaskRole\",\n  \"containerDefinitions\": [\n    {\n      \"name\": \"mini-java-app\",\n      \"image\": \"{{IMAGE_URI}}\",\n      \"essential\": true,\n      \"portMappings\": [\n        {\n          \"containerPort\": 8080,\n          \"protocol\": \"tcp\"\n        }\n      ],\n      \"environment\": [\n        {\"name\": \"SERVER_PORT\", \"value\": \"8080\"},\n        {\"name\": \"SERVER_HOST\", \"value\": \"0.0.0.0\"},\n        {\"name\": \"CONFIG_DIR\", \"value\": \"/app/config\"},\n        {\"name\": \"LOG_DIR\", \"value\": \"/app/logs\"},\n        {\"name\": \"TEMP_DIR\", \"value\": \"/app/temp\"},\n        {\"name\": \"UPLOAD_DIR\", \"value\": \"/app/uploads\"},\n        {\"name\": \"CONFIG_PATH\", \"value\": \"/app/config\"},\n        {\"name\": \"LOG_PATH\", \"value\": \"/app/logs\"},\n        {\"name\": \"JAVA_OPTS\", \"value\": \"-Xmx512m -Xms256m -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0\"},\n        {\"name\": \"DB_HOST\", \"value\": \"{{DB_HOST}}\"},\n        {\"name\": \"DB_PORT\", \"value\": \"{{DB_PORT}}\"},\n        {\"name\": \"DB_NAME\", \"value\": \"{{DB_NAME}}\"},\n        {\"name\": \"REDIS_HOST\", \"value\": \"{{REDIS_HOST}}\"},\n        {\"name\": \"REDIS_PORT\", \"value\": \"{{REDIS_PORT}}\"},\n        {\"name\": \"RABBITMQ_HOST\", \"value\": \"{{RABBITMQ_HOST}}\"},\n        {\"name\": \"EXTERNAL_API_URL\", \"value\": \"{{EXTERNAL_API_URL}}\"},\n        {\"name\": \"PAYMENT_SERVICE_URL\", \"value\": \"{{PAYMENT_SERVICE_URL}}\"},\n        {\"name\": \"MONITORING_ENDPOINT\", \"value\": \"{{MONITORING_ENDPOINT}}\"}\n      ],\n      \"logConfiguration\": {\n        \"logDriver\": \"awslogs\",\n        \"options\": {\n          \"awslogs-group\": \"/ecs/mini-java-app\",\n          \"awslogs-region\": \"{{AWS_REGION}}\",\n          \"awslogs-stream-prefix\": \"ecs\"\n        }\n      }\n    }\n  ]\n}"
