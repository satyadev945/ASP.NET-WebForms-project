@model IEnumerable<Films.Domain.Entities.Film>

@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to Films Application</h1>
    <p>Manage your film collection with ease.</p>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <h2>Recent Films</h2>
        @if (Model != null && Model.Any())
        {
            <div class="row">
                @foreach (var film in Model.Take(6))
                {
                    <div class="col-md-4 mb-3">
                        <div class="card">
                            <div class="card-body">
                                <h5 class="card-title">@film.Title</h5>
                                <p class="card-text">@(film.Year?.ToString() ?? "N/A")</p>
                                <p class="card-text">@(film.Genre ?? "Unknown Genre")</p>
                                <a asp-controller="Films" asp-action="Details" asp-route-id="@film.Id" class="btn btn-primary">View Details</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="text-center mt-3">
                <a asp-controller="Films" asp-action="Index" class="btn btn-secondary">View All Films</a>
            </div>
        }
        else
        {
            <p>No films available. <a asp-controller="Films" asp-action="Create">Add your first film</a>.</p>
        }
    </div>
</div>
