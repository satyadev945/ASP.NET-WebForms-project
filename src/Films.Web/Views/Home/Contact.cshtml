        <p>
            Stay connected with us on social media to get the latest updates.
        </p>
        <div class="social-links">
            <a href="#" class="me-3">Twitter</a>
            <a href="#" class="me-3">Facebook</a>
            <a href="#" class="me-3">Instagram</a>
        </div>
    </div>
</div>