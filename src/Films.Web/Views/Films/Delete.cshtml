@model Films.Domain.DTOs.FilmDto
@{
    ViewData["Title"] = "Delete Film";
}

<div class="container">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <h2>Delete Film</h2>

            <div class="alert alert-warning" role="alert">
                <h4 class="alert-heading">Are you sure you want to delete this film?</h4>
                <p>This action cannot be undone.</p>
            </div>

            <div class="card">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Name" style="height: 300px; object-fit: cover;">
                }
                <div class="card-body">
                    <h3 class="card-title">@Model.Name</h3>

                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Year:</strong> @Model.Year</p>
                            @if (!string.IsNullOrEmpty(Model.Genre))
                            {
                                <p><strong>Genre:</strong> @Model.Genre</p>
                            }
                        </div>
                        <div class="col-md-6">
                            <p><strong>Created:</strong> @Model.CreatedDate.ToString("dd/MM/yyyy")</p>
                            <p><strong>Created By:</strong> @Model.CreatedBy</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <hr>
                        <div>
                            <strong>Description:</strong>
                            <p class="mt-2">@Model.Description</p>
                        </div>
                    }
                </div>
            </div>

            <div class="mt-4 d-flex justify-content-between">
                <form asp-controller="Films" asp-action="Delete" method="post">
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Confirm Delete
                    </button>
                </form>
                <div>
                    <a asp-controller="Films" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info">
                        <i class="fas fa-eye"></i> View Details
                    </a>
                    <a asp-controller="Films" asp-action="Index" class="btn btn-secondary ms-2">
                        <i class="fas fa-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>