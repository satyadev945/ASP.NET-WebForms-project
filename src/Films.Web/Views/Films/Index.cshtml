@model Films.Web.ViewModels.FilmsIndexViewModel
@{
    ViewData["Title"] = "Films";
}

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>All Films</h2>
                <a asp-controller="Films" asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Add New Film
                </a>
            </div>

            <!-- Search Form -->
            <form method="get" class="mb-4">
                <div class="row">
                    <div class="col-md-8">
                        <input asp-for="SearchTerm" class="form-control" placeholder="Search films by name, description, or genre..." />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-outline-secondary w-100">Search</button>
                    </div>
                    <div class="col-md-2">
                        <a asp-controller="Films" asp-action="Index" class="btn btn-outline-info w-100">Clear</a>
                    </div>
                </div>
            </form>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (Model.Films?.Any() == true)
            {
                <div class="row">
                    @foreach (var film in Model.Films)
                    {
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100">
                                @if (!string.IsNullOrEmpty(film.ImageUrl))
                                {
                                    <img src="@film.ImageUrl" class="card-img-top" alt="@film.Name" style="height: 200px; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                        <span class="text-muted">No Image</span>
                                    </div>
                                }
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">@film.Name</h5>
                                    <p class="card-text flex-grow-1">
                                        <strong>Year:</strong> @film.Year<br>
                                        @if (!string.IsNullOrEmpty(film.Genre))
                                        {
                                            <strong>Genre:</strong> @film.Genre<br>
                                        }
                                        @if (!string.IsNullOrEmpty(film.Description))
                                        {
                                            <span class="text-muted">@(film.Description.Length > 100 ? film.Description.Substring(0, 100) + "..." : film.Description)</span>
                                        }
                                    </p>
                                    <div class="mt-auto">
                                        <div class="btn-group w-100" role="group">
                                            <a asp-controller="Films" asp-action="Details" asp-route-id="@film.Id" class="btn btn-outline-info btn-sm">Details</a>
                                            <a asp-controller="Films" asp-action="Edit" asp-route-id="@film.Id" class="btn btn-outline-warning btn-sm">Edit</a>
                                            <a asp-controller="Films" asp-action="Delete" asp-route-id="@film.Id" class="btn btn-outline-danger btn-sm">Delete</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="mt-4 text-muted">
                    <small>Found @Model.Films.Count() film(s)</small>
                </div>
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    <h4 class="alert-heading">No Films Found</h4>
                    <p>@(string.IsNullOrEmpty(Model.SearchTerm) ? "There are no films in the database yet." : $"No films found matching '{Model.SearchTerm}'.")</p>
                    <hr>
                    <p class="mb-0">
                        <a asp-controller="Films" asp-action="Create" class="btn btn-primary">Add the first film</a>
                        @if (!string.IsNullOrEmpty(Model.SearchTerm))
                        {
                            <a asp-controller="Films" asp-action="Index" class="btn btn-secondary ms-2">View all films</a>
                        }
                    </p>
                </div>
            }
        </div>
    </div>
</div>