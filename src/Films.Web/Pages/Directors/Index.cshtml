@page
@model Films.Web.Pages.Directors.IndexModel
@{
    ViewData["Title"] = "Directors";
}

<h1>Directors</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Create New</a>
</p>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Sex</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var director in Model.Directors)
        {
            <tr>
                <td>@director.Name</td>
                <td>@director.SexName</td>
                <td>@director.Description</td>
                <td>
                    <a asp-page="Details" asp-route-id="@director.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-page="Edit" asp-route-id="@director.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-page="Delete" asp-route-id="@director.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
