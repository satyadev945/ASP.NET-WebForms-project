@page "{id:int}"
@model Films.Web.Pages.Films.DetailsModel
@{
    ViewData["Title"] = "Детайли за филм";
}

<h1>Детайли за филм</h1>

@if (Model.Film != null)
{
    <div class="card">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Име</dt>
                <dd class="col-sm-9">@Model.Film.Name</dd>

                <dt class="col-sm-3">Описание</dt>
                <dd class="col-sm-9">@Model.Film.Description</dd>

                <dt class="col-sm-3">Година</dt>
                <dd class="col-sm-9">@Model.Film.Year</dd>

                <dt class="col-sm-3">Дата на създаване</dt>
                <dd class="col-sm-9">@Model.Film.CreatedDate.ToString("dd.MM.yyyy HH:mm")</dd>

                @if (Model.Film.ModifiedDate.HasValue)
                {
                    <dt class="col-sm-3">Последна промяна</dt>
                    <dd class="col-sm-9">@Model.Film.ModifiedDate.Value.ToString("dd.MM.yyyy HH:mm")</dd>
                }

                <dt class="col-sm-3">Активен</dt>
                <dd class="col-sm-9">@(Model.Film.IsActive ? "Да" : "Не")</dd>
            </dl>
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="Edit" asp-route-id="@Model.Film.Id" class="btn btn-warning">Редактирай</a>
        <a asp-page="Delete" asp-route-id="@Model.Film.Id" class="btn btn-danger">Изтрий</a>
        <a asp-page="Index" class="btn btn-secondary">Назад към списъка</a>
    </div>
}
else
{
    <p class="alert alert-warning">Филмът не е намерен.</p>
    <a asp-page="Index" class="btn btn-secondary">Назад към списъка</a>
}
