@page
@model Films.Web.Pages.Films.IndexModel
@{
    ViewData["Title"] = "Филми";
}

<h1>Филми</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Създай нов</a>
</p>

@if (Model.Films != null && Model.Films.Any())
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Име</th>
                <th>Описание</th>
                <th>Година</th>
                <th>Дата на създаване</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var film in Model.Films)
            {
                <tr>
                    <td>@film.Name</td>
                    <td>@film.Description</td>
                    <td>@film.Year</td>
                    <td>@film.CreatedDate.ToString("dd.MM.yyyy")</td>
                    <td>
                        <a asp-page="Details" asp-route-id="@film.Id" class="btn btn-sm btn-info">Детайли</a>
                        <a asp-page="Edit" asp-route-id="@film.Id" class="btn btn-sm btn-warning">Редактирай</a>
                        <a asp-page="Delete" asp-route-id="@film.Id" class="btn btn-sm btn-danger">Изтрий</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Няма налични филми.</p>
}
