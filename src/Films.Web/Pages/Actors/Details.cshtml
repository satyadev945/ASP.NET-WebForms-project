@page
@model Films.Web.Pages.Actors.DetailsModel
@{
    ViewData["Title"] = "Actor Details";
}

<h1>Actor Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Name</dt>
        <dd class="col-sm-9">@Model.Actor?.Name</dd>

        <dt class="col-sm-3">Sex</dt>
        <dd class="col-sm-9">@Model.Actor?.SexName</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Actor?.Description</dd>

        <dt class="col-sm-3">Created Date</dt>
        <dd class="col-sm-9">@Model.Actor?.CreatedDate.ToString("yyyy-MM-dd")</dd>

        <dt class="col-sm-3">Modified Date</dt>
        <dd class="col-sm-9">@Model.Actor?.ModifiedDate?.ToString("yyyy-MM-dd")</dd>
    </dl>
</div>
<div>
    <a asp-page="Edit" asp-route-id="@Model.Actor?.Id" class="btn btn-warning">Edit</a>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
</div>
