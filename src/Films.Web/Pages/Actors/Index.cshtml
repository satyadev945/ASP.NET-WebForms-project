@page
@model Films.Web.Pages.Actors.IndexModel
@{
    ViewData["Title"] = "Actors";
}

<h2>Actors</h2>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <p class="text-muted mb-0">Manage your actors database</p>
    </div>
    <div>
        <a asp-page="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add New Actor
        </a>
    </div>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <form method="get">
            <div class="input-group">
                <input type="text" name="searchString" value="@Model.CurrentFilter" class="form-control" placeholder="Search actors..." />
                <button class="btn btn-outline-secondary" type="submit">Search</button>
                @if (!string.IsNullOrEmpty(Model.CurrentFilter))
                {
                    <a asp-page="Index" class="btn btn-outline-secondary">Clear</a>
                }
            </div>
        </form>
    </div>
</div>

@if (Model.Actors?.Any() == true)
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Created Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var actor in Model.Actors)
                {
                    <tr>
                        <td>@actor.Name</td>
                        <td>
                            @if (!string.IsNullOrEmpty(actor.Description))
                            {
                                @(actor.Description.Length > 100 ? actor.Description.Substring(0, 100) + "..." : actor.Description)
                            }
                        </td>
                        <td>@actor.CreatedDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            @if (actor.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group" role="group">
                                <a asp-page="Details" asp-route-id="@actor.Id" class="btn btn-sm btn-outline-info">Details</a>
                                <a asp-page="Edit" asp-route-id="@actor.Id" class="btn btn-sm btn-outline-warning">Edit</a>
                                <a asp-page="Delete" asp-route-id="@actor.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-info" role="alert">
        <h4 class="alert-heading">No actors found</h4>
        @if (!string.IsNullOrEmpty(Model.CurrentFilter))
        {
            <p>No actors match your search criteria. <a asp-page="Index">Show all actors</a></p>
        }
        else
        {
            <p>There are no actors in the database yet. <a asp-page="Create">Add the first actor</a></p>
        }
    </div>
}