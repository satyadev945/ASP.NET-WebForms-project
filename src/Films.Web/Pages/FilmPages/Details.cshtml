@page "{id:int}"
@model Films.Web.Pages.FilmPages.DetailsModel
@{
    ViewData["Title"] = "Film Details";
}

<h1>Film Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Film.Name</dd>

        <dt class="col-sm-2">Year</dt>
        <dd class="col-sm-10">@Model.Film.Year</dd>

        <dt class="col-sm-2">Description</dt>
        <dd class="col-sm-10">@(Model.Film.Description ?? "N/A")</dd>

        <dt class="col-sm-2">Created Date</dt>
        <dd class="col-sm-10">@Model.Film.CreatedDate.ToString("yyyy-MM-dd HH:mm:ss")</dd>

        <dt class="col-sm-2">Modified Date</dt>
        <dd class="col-sm-10">@(Model.Film.ModifiedDate?.ToString("yyyy-MM-dd HH:mm:ss") ?? "N/A")</dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Film.Id" class="btn btn-warning">Edit</a>
    <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
</div>
